---
import { GITHUB_URL } from '../consts';
---

<header>
	<nav>
		<a href="/" class="logo" aria-label="홈">MC</a>
		<div class="nav-links">
			<a href="/#about">ABOUT</a>
			<a href="/#skills">SKILLS</a>
			<a href="/#projects">PROJECTS</a>
			<a href="/#contact">CONTACT</a>
			<a href="/blog" class="nav-divider">블로그</a>
			<a href={GITHUB_URL} target="_blank" rel="noopener" class="github-link" aria-label="GitHub">
				<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
					<path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
				</svg>
			</a>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		padding: 0 4em;
		background: rgba(7, 9, 13, 0.8);
		backdrop-filter: blur(16px);
		border-bottom: 1px solid rgb(var(--border));
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1100px;
		margin: 0 auto;
		height: 88px;
	}
	.logo {
		font-family: var(--font-display);
		font-size: 1.15rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		color: rgb(var(--text));
		text-decoration: none;
	}
	.logo:hover { color: var(--accent); text-decoration: none; }

	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.1em;
	}
	.nav-links a {
		padding: 0.45em 0.9em;
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		color: rgb(var(--text-muted));
		text-decoration: none;
		transition: color 0.15s;
	}
	.nav-links a:hover { color: rgb(var(--text)); text-decoration: none; }

	.nav-divider {
		border-left: 1px solid rgb(var(--border));
		margin-left: 0.5em;
		padding-left: 1.1em !important;
	}
	.github-link {
		display: flex;
		align-items: center;
		padding: 0.45em 0.6em !important;
		margin-left: 0.3em;
		border-radius: 6px;
		transition: background 0.15s, color 0.15s !important;
	}
	.github-link:hover {
		background: rgb(var(--bg-card));
		color: rgb(var(--text)) !important;
	}
	@media (max-width: 640px) {
		header { padding: 0 1.25em; }
		nav { height: 60px; }
		.nav-links a:not(.github-link):not(.nav-divider) { display: none; }
	}
</style>
