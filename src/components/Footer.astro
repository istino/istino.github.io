---
import { GITHUB_URL } from '../consts';
const year = new Date().getFullYear();
---

<footer>
	<div class="footer-inner">
		<div class="footer-left">
			<span class="fname">KIM MINCHUL</span>
			<span class="frole">Game Client Developer</span>
		</div>
		<div class="footer-center">
			<span>© {year} All rights reserved.</span>
		</div>
		<div class="footer-right">
			<a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>
			<a href="mailto:lostwaltz89@gmail.com">Contact</a>
		</div>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid rgb(var(--border));
		padding: 0 4em;
		position: relative;
		z-index: 1;
	}
	.footer-inner {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		max-width: 1100px;
		margin: 0 auto;
		height: 72px;
		gap: 1em;
	}
	.footer-left {
		display: flex;
		flex-direction: column;
		gap: 0.1em;
	}
	.fname {
		font-family: var(--font-display);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: rgb(var(--text));
	}
	.frole {
		font-size: 0.62rem;
		letter-spacing: 0.06em;
		color: rgb(var(--text-muted));
		opacity: 0.6;
	}
	.footer-center {
		font-size: 0.65rem;
		color: rgb(var(--text-muted));
		opacity: 0.4;
		letter-spacing: 0.04em;
		text-align: center;
	}
	.footer-right {
		display: flex;
		justify-content: flex-end;
		gap: 1.5em;
	}
	.footer-right a {
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		color: rgb(var(--text-muted));
		text-decoration: none;
		transition: color 0.15s;
	}
	.footer-right a:hover { color: var(--accent); text-decoration: none; }

	@media (max-width: 640px) {
		footer { padding: 0 1.25em; }
		.footer-inner {
			grid-template-columns: 1fr;
			height: auto;
			padding: 1.5em 0;
			gap: 0.75em;
			text-align: center;
		}
		.footer-left { align-items: center; }
		.footer-right { justify-content: center; }
	}
</style>
