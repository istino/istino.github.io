---
import { GITHUB_URL } from '../consts';
const year = new Date().getFullYear();
---

<footer>
	<span>© {year} 김민철</span>
	<span class="sep">·</span>
	<a href={GITHUB_URL} target="_blank" rel="noopener">github.com/lostwaltz</a>
</footer>

<style>
	footer {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5em;
		padding: 2em 1em;
		border-top: 1px solid rgb(var(--border));
		color: rgb(var(--text-muted));
		font-size: 0.875rem;
	}
	footer a {
		color: rgb(var(--text-muted));
		text-decoration: none;
	}
	footer a:hover {
		color: var(--accent);
		text-decoration: none;
	}
	.sep {
		opacity: 0.4;
	}
</style>
