---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title="블로그 — 김민철" description="게임 클라이언트 개발 관련 기술 글" />
	</head>
	<body>
		<Header />
		<main>
			<h1>블로그</h1>
			{posts.length === 0 ? (
				<p class="empty">아직 작성된 글이 없습니다.</p>
			) : (
				<ul>
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<span class="post-title">{post.data.title}</span>
								<span class="post-date">
									{post.data.pubDate.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}
								</span>
							</a>
						</li>
					))}
				</ul>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	main { max-width: 720px; padding-top: 3em; }
	h1 {
		font-size: 2rem;
		font-weight: 800;
		letter-spacing: -0.03em;
		margin-bottom: 1.5em;
	}
	ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	ul li a {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1em;
		padding: 1em 0;
		border-bottom: 1px solid rgb(var(--border));
		text-decoration: none;
		color: rgb(var(--text));
		transition: color 0.15s;
	}
	ul li a:hover {
		color: var(--accent);
		text-decoration: none;
	}
	.post-title { font-size: 1rem; }
	.post-date {
		font-size: 0.825rem;
		color: rgb(var(--text-muted));
		white-space: nowrap;
		flex-shrink: 0;
	}
	.empty {
		color: rgb(var(--text-muted));
		font-style: italic;
	}
</style>
