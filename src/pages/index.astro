---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, GITHUB_URL } from '../consts';
import { getCollection } from 'astro:content';

const portfolio = (await getCollection('portfolio', ({ data }) => !data.draft))
	.sort((a, b) => a.data.priority - b.data.priority);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="print-btn no-print">
				<button onclick="window.print()">PDF로 저장</button>
			</div>

			<!-- 나는 누구인가 -->
			<section class="hero">
				<p class="label">Game Client Developer</p>
				<h1>김민철</h1>
				<p class="desc">
					게임의 경험을 만드는 클라이언트 개발자.<br />
					C#과 Unity로 플레이어가 느끼는 순간을 설계합니다.
				</p>
				<div class="contacts">
					<a href="mailto:lostwaltz89@gmail.com">lostwaltz89@gmail.com</a>
					<span class="sep">·</span>
					<a href={GITHUB_URL} target="_blank" rel="noopener">github.com/lostwaltz</a>
					<span class="sep">·</span>
					<a href="https://istino.github.io">istino.github.io</a>
				</div>
			</section>

			<hr />

			<!-- 기술 스택 -->
			<section class="section">
				<h2 class="section-title">기술 스택</h2>
				<div class="skill-grid">
					<div class="skill-group">
						<h3>주력</h3>
						<p>C#, Unity, C++</p>
					</div>
					<div class="skill-group">
						<h3>그래픽스</h3>
						<p>DirectX</p>
					</div>
					<div class="skill-group">
						<h3>기타</h3>
						<p>DOTween, JSON</p>
					</div>
				</div>
			</section>

			<hr />

			<!-- 포트폴리오 -->
			<section class="section">
				<h2 class="section-title">포트폴리오</h2>
				{portfolio.map((item) => (
					<div class="portfolio-item">
						<div class="item-header">
							<h3>
								<a href={`/portfolio/${item.id}/`}>{item.data.title}</a>
							</h3>
							<div class="tech-tags">
								{item.data.tech.map((t) => <span>{t}</span>)}
							</div>
						</div>
						<p class="item-desc">{item.data.description}</p>
					</div>
				))}
			</section>

			<hr />

			<!-- 학력 -->
			<section class="section">
				<h2 class="section-title">학력</h2>
				<p class="placeholder">추가 예정</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 720px;
		padding-top: 2em;
		padding-bottom: 4em;
	}

	.print-btn {
		display: flex;
		justify-content: flex-end;
		margin-bottom: 2em;
	}
	.print-btn button {
		padding: 0.5em 1.2em;
		background: transparent;
		border: 1px solid rgb(var(--border));
		border-radius: 6px;
		color: rgb(var(--text-muted));
		font-size: 0.875rem;
		cursor: pointer;
		transition: border-color 0.15s, color 0.15s;
	}
	.print-btn button:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	/* 히어로 */
	.hero {
		position: relative;
		padding: 3em 0 2.5em;
		overflow: hidden;
	}
	.hero::before {
		content: '';
		position: absolute;
		top: 40%;
		left: -15%;
		width: 600px;
		height: 500px;
		background: radial-gradient(ellipse, rgba(88, 166, 255, 0.1) 0%, transparent 65%);
		transform: translateY(-50%);
		pointer-events: none;
		z-index: 0;
	}
	.hero > * { position: relative; z-index: 1; }

	.label {
		font-size: 0.8rem;
		color: var(--accent);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		margin: 0 0 0.5em;
	}
	.hero h1 {
		font-size: 3rem;
		font-weight: 800;
		letter-spacing: -0.03em;
		margin: 0 0 0.4em;
		line-height: 1;
		text-shadow: 0 0 60px rgba(88, 166, 255, 0.25);
	}
	.desc {
		font-size: 1rem;
		color: rgb(var(--text-muted));
		line-height: 1.6;
		margin: 0 0 1em;
	}
	.contacts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25em;
		font-size: 0.875rem;
		color: rgb(var(--text-muted));
	}
	.contacts a { color: rgb(var(--text-muted)); }
	.contacts a:hover { color: var(--accent); text-decoration: none; }
	.sep { opacity: 0.4; }

	/* 섹션 공통 */
	.section { padding: 2em 0; }
	.section-title {
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: rgb(var(--text-muted));
		margin: 0 0 1.25em;
	}

	/* 기술 스택 */
	.skill-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		gap: 1.5em;
	}
	.skill-group h3 {
		font-size: 0.8rem;
		color: rgb(var(--text-muted));
		font-weight: 600;
		margin: 0 0 0.25em;
	}
	.skill-group p {
		font-family: monospace;
		font-size: 0.95rem;
		margin: 0;
		color: rgb(var(--text));
	}

	/* 포트폴리오 */
	.portfolio-item {
		padding: 1.5em 0;
		border-bottom: 1px solid rgb(var(--border));
	}
	.portfolio-item:last-child { border-bottom: none; }
	.item-header {
		display: flex;
		align-items: baseline;
		gap: 1em;
		flex-wrap: wrap;
		margin-bottom: 0.5em;
	}
	.item-header h3 {
		font-size: 1.1rem;
		font-weight: 700;
		margin: 0;
	}
	.item-header h3 a {
		color: rgb(var(--text));
		text-decoration: none;
	}
	.item-header h3 a:hover { color: var(--accent); }
	.tech-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35em;
	}
	.tech-tags span {
		padding: 0.15em 0.55em;
		background: rgb(var(--bg-card));
		border: 1px solid rgb(var(--border));
		border-radius: 4px;
		font-size: 0.75rem;
		font-family: monospace;
		color: rgb(var(--text-muted));
	}
	.item-desc {
		font-size: 0.9rem;
		color: rgb(var(--text-muted));
		margin: 0;
		line-height: 1.5;
	}

	.placeholder {
		color: rgb(var(--text-muted));
		font-style: italic;
		font-size: 0.9rem;
	}

	@media print {
		.hero h1 { color: black !important; text-shadow: none !important; }
		.hero::before { display: none; }
		.label { color: #555 !important; }
		.desc, .contacts, .contacts a { color: #444 !important; }
		.section-title { color: #666 !important; }
		.skill-group h3 { color: #666 !important; }
		.item-desc { color: #444 !important; }
		.item-header h3 a { color: black !important; }
		.tech-tags span {
			background: #f0f0f0 !important;
			border-color: #ccc !important;
			color: #333 !important;
		}
	}
</style>
