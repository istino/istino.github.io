---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, GITHUB_URL } from '../consts';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const portfolio = (await getCollection('portfolio', ({ data }) => !data.draft))
	.sort((a, b) => a.data.priority - b.data.priority);

const featuredProject = portfolio[0];
const secondaryProjects = portfolio.slice(1);

const skillGroups = [
	{ num: '01', label: '언어',           items: ['C#', 'C++'] },
	{ num: '02', label: '엔진 / 프레임워크', items: ['Unity', 'UniTask', 'URP'] },
	{ num: '03', label: '그래픽스',        items: ['HLSL', 'URP Renderer Feature', 'DirectX 11'] },
	{ num: '04', label: '도구 및 라이브러리', items: ['DOTween', 'Firebase', 'Addressables', 'Git'] },
	{ num: '05', label: '플랫폼',          items: ['Windows API / Native', 'P/Invoke', 'C++ Plugin'] },
];

---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>

			<!-- ── Hero ── -->
			<section id="about" class="hero hero-init">
				<div class="hero-left">
					<p class="eyebrow">게임 클라이언트 개발자</p>
					<h1>KIM<br />MINCHUL</h1>
					<div class="hero-actions">
						<a href="#projects" class="btn-outline">&gt; VIEW WORK</a>
						<a href="mailto:lostwaltz89@gmail.com" class="btn-ghost">CONTACT ME</a>
					</div>
					<div class="hero-meta">
						<span>BASED IN SEOUL, KR</span>
						<span>AVAILABLE FOR FULLTIME ROLES</span>
					</div>
				</div>

				<div class="hero-right">
					<div class="hero-photo-frame">
						<img src="/profile/profile.png" alt="김민철" class="hero-photo" />
					</div>
				</div>
				<!-- Skills strip inside hero -->
				<div class="hero-skills" id="skills">
					{skillGroups.map(g => (
						<div class="skill-group">
							<span class="sg-num">{g.num}</span>
							<span class="sg-label">{g.label}</span>
							<ul class="sg-items">
								{g.items.map(item => <li>{item}</li>)}
							</ul>
						</div>
					))}
				</div>
			</section>

			<!-- ── About ── -->
			<section class="section about-section" id="contact">
				<!-- 소개 -->
				<div class="about-intro">
					<div class="about-intro-left">
						<span class="section-label">// 소개</span>
						<h2 class="about-headline">최근 프로젝트 흐름으로<br />자기소개를 대신하겠습니다.</h2>
					</div>
					<div class="about-intro-right">
						<div class="about-story-block">
							<p>저는 내일배움캠프 최종 프로젝트에서 모작을 선택했습니다. 팀원 섭외부터 에셋 확보, 프레임워크 환경 구축까지 미리 해두고 설득에 나섰고, 처음엔 다들 떨떠름했습니다. 1~2주차에 다른 팀이 아직 기획을 잡는 동안 저희 팀은 이미 게임처럼 돌아가는 걸 만들고 있었습니다. 결과적으로 23팀 중 1위를 했습니다.</p>
						</div>
						<div class="about-story-block">
							<p>캠프 이후 연계 인턴으로 카카오 라이선스 타이틀 개발에 잠깐 합류했고, 지금은 Hearth를 만들고 있습니다. 배경화면 임베딩 과정에서 HWND 포커스 제어, 입력 처리같이 케이스 자체가 드문 영역이 많았고, 직접 서치하고 케이스를 하나씩 소거하며 풀었습니다. 포폴용으로 시작했지만 Steam 데모로 출시했습니다.</p>
						</div>
						<div class="about-story-block about-story-closing">
							<p>Hearth를 포함해, 여러 프로젝트를 직접 만들어오며 쌓은 것들을 팀에서 펼쳐보이고 싶습니다.</p>
						</div>
					</div>
				</div>

				<!-- 성격 -->
				<div class="about-personality">
					<div class="about-pers-left">
						<span class="section-label">// 성격</span>
						<p class="about-pers-summary">기간 내 완료를 당연하게 여기고,<br />기대치를 출발점으로 삼습니다.</p>
					</div>
					<div class="about-pers-grid">
						<div class="pers-card">
							<p class="pers-title">기간 내 완료를 당연하게 여깁니다.</p>
							<p class="pers-desc">내배캠에서 담당 작업을 먼저 마치면 막히는 팀원을 찾아 도왔고, 다음에도 같이 하고 싶다는 말을 들었습니다.</p>
						</div>
						<div class="pers-card">
							<p class="pers-title">모르는 코드도 직접 파헤칩니다.</p>
							<p class="pers-desc">팀원이 만든 자체 엔진을 급하게 써야 했을 때, 문서 없는 코드를 분석해 구조를 빠르게 파악하고 작업에 들어갔습니다.</p>
						</div>
						<div class="pers-card">
							<p class="pers-title">기대치를 출발점으로 삼습니다.</p>
							<p class="pers-desc">팀에서 기대하는 것에 맞추는 게 최소치라고 생각합니다. 그 이상을 목표로 합니다.</p>
						</div>
						<div class="pers-card pers-card--weak">
							<p class="pers-title">결과물을 오래 들여다봅니다.</p>
							<p class="pers-desc">충분히 됐는데도 한 번 더 다듬고 싶어지는 경향이 있어서, 기준을 먼저 정해두고 시작하는 방식으로 조율하고 있습니다.</p>
						</div>
					</div>
				</div>
			</section>

			<!-- ── Selected Projects ── -->
			<section id="projects" class="section">
				<div class="section-header">
					<span class="section-label">// 프로젝트</span>
					<a href="/portfolio/" class="section-action">전체 보기</a>
				</div>

				<div class="project-list">
					{portfolio.map(item => (
						<div class="fp-card">
							<!-- Left: featured bullets + sub bullets (main) -->
							<div class="fp-content">
								{item.data.featuredBullets && (
									<div class="fp-highlights">
										{item.data.featuredBullets.map(fb => (
											<div class="fp-highlight-item">
												<span class="fph-title">{fb.title}</span>
												<span class="fph-desc">{fb.description}</span>
											</div>
										))}
									</div>
								)}
								{item.data.bullets && item.data.bullets.length > 0 && (
									<ul class="fp-bullets">
										{item.data.bullets.map(b => <li>{b}</li>)}
									</ul>
								)}
							</div>
							<!-- Right: thumbnail + title + meta (secondary) -->
							<div class="fp-sidebar">
								<div class="fp-sidebar-header">
									<h2 class="fp-title">{item.data.title}</h2>
									<div class="fp-tags">
										{item.data.tech.map(t => <span>{t}</span>)}
									</div>
									<div class="fp-meta">
										{item.data.period && <span>{item.data.period}</span>}
										{item.data.team && <span class="fp-type">{item.data.team}</span>}
									</div>
									<a href={`/portfolio/${item.id}/`} class="fp-link">VIEW PROJECT &#8599;</a>
								</div>
								<div class="fp-visual">
									{item.data.thumbnail
										? <img src={item.data.thumbnail} alt={item.data.title} loading="lazy" />
										: <div class="fp-placeholder">
												<div class="fp-grid-bg"></div>
												<span class="fp-letter">{item.data.title[0]}</span>
											</div>
									}
								</div>
							</div>
						</div>
					))}
				</div>
			</section>

			<!-- ── Background ── -->
			<section class="section bg-grid-section">
				<div class="bg-grid">
					<div class="bg-col">
						<span class="section-label">// 경력 및 교육</span>
						<div class="bg-list">
							<div class="bg-item">
								<span class="bg-period">2025.04 – 2025.05</span>
								<span class="bg-name">메타빌</span>
								<span class="bg-detail">Unity 클라이언트 인턴 — 쓰머 FOR KAKAO</span>
							</div>
							<div class="bg-item">
								<span class="bg-period">2025.02 – 2026.01</span>
								<span class="bg-name">스파르타코딩클럽 내일배움캠프</span>
								<span class="bg-detail">Unity 게임 개발 6기</span>
							</div>
							<div class="bg-item">
								<span class="bg-period">2020.01 – 2021.01</span>
								<span class="bg-name">쥬신게임아카데미</span>
								<span class="bg-detail">게임 프로그래밍</span>
							</div>
						</div>
					</div>
					<div class="bg-col">
						<span class="section-label">// 학력 및 병역</span>
						<div class="bg-list">
							<div class="bg-item">
								<span class="bg-period">2014.03 – 2017.02</span>
								<span class="bg-name">선유고등학교</span>
								<span class="bg-detail">졸업</span>
							</div>
							<div class="bg-item">
								<span class="bg-period">2018.04 – 2019.12</span>
								<span class="bg-name">대한민국 육군</span>
								<span class="bg-detail">병장 만기전역</span>
							</div>
						</div>
					</div>
					<div class="bg-col">
						<span class="section-label">// 자격증</span>
						<div class="bg-list">
							<div class="bg-item">
								<span class="bg-period">2016</span>
								<span class="bg-name">GTQ</span>
								<span class="bg-detail">한국생산성본부</span>
							</div>
							<div class="bg-item">
								<span class="bg-period">2016</span>
								<span class="bg-name">워드프로세서 1급</span>
								<span class="bg-detail">대한상공회의소</span>
							</div>
							<div class="bg-item">
								<span class="bg-period">2016</span>
								<span class="bg-name">컴퓨터활용능력 2급</span>
								<span class="bg-detail">대한상공회의소</span>
							</div>
						</div>
					</div>
				</div>
			</section>


		</main>
		<Footer />
	</body>
</html>

<script>
// Hero 최초 로드 시 한 번만 fade-in
requestAnimationFrame(() => {
	document.querySelector('.hero-init')?.classList.add('hero-visible');
});

</script>

<style>
	main {
		width: 100%;
		max-width: 1280px;
		margin: 0 auto;
		padding: 0 2.5rem 8rem;
	}

	/* Hero 최초 로드 애니메이션 */
	.hero-init {
		opacity: 0;
		transform: translateY(16px);
		transition: opacity 0.7s ease, transform 0.7s ease;
	}
	.hero-visible {
		opacity: 1;
		transform: translateY(0);
	}

	/* ── Hero ── */
	.hero {
		display: grid;
		grid-template-columns: 5fr 7fr;
		grid-template-rows: auto auto;
		gap: 4rem 4rem;
		align-items: center;
		padding: 5rem 0 0;
		border-bottom: 1px solid rgb(var(--border));
		margin-bottom: 0;
	}

	.hero-skills {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 0;
		border-top: 1px solid rgb(var(--border));
		padding: 2rem 0;
	}

	.eyebrow {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		font-weight: 500;
		letter-spacing: 0.2em;
		color: var(--accent);
		margin: 0 0 1.5rem;
	}

	.hero-left h1 {
		font-family: var(--font-display);
		font-size: clamp(3.5rem, 6.5vw, 6rem);
		font-weight: 800;
		letter-spacing: -0.06em;
		line-height: 0.9;
		text-transform: uppercase;
		margin: 0 0 1.25rem;
		color: rgb(var(--text));
	}

	.hero-desc {
		font-size: 0.875rem;
		color: rgb(var(--text-muted));
		line-height: 1.85;
		margin: 0 0 2.5rem;
		max-width: 340px;
	}

	.hero-actions {
		display: flex;
		gap: 0.75rem;
		margin-bottom: 2.5rem;
	}

	.btn-outline {
		padding: 0.55em 1.4em;
		border: 1px solid var(--accent);
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-decoration: none;
		border-radius: 3px;
		transition: background 0.2s;
	}
	.btn-outline:hover { background: rgba(91,140,255,0.1); text-decoration: none; }

	.btn-ghost {
		padding: 0.55em 1.4em;
		border: 1px solid rgb(var(--border));
		color: rgb(var(--text-muted));
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-decoration: none;
		border-radius: 3px;
		transition: border-color 0.2s, color 0.2s;
	}
	.btn-ghost:hover { border-color: rgb(var(--text-muted)); color: rgb(var(--text)); text-decoration: none; }

	.hero-meta {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		font-family: var(--font-mono);
		font-size: 0.6rem;
		letter-spacing: 0.14em;
		color: rgb(var(--text-muted));
		opacity: 0.45;
		text-transform: uppercase;
	}

	/* Hero right — profile photo */
	.hero-right {
		display: flex;
		justify-content: center;
		align-items: flex-start;
	}

	.hero-photo-frame {
		width: 100%;
		max-width: 280px;
		border: 1px solid rgba(255,255,255,0.1);
		border-radius: 6px;
		box-shadow: 0 8px 32px rgba(0,0,0,0.5);
		overflow: hidden;
		position: relative;
	}
	.hero-photo-frame::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background:
			radial-gradient(ellipse at center, transparent 50%, rgba(4,7,14,0.35) 100%),
			linear-gradient(to bottom, rgba(4,7,14,0.15) 0%, transparent 20%, transparent 80%, rgba(4,7,14,0.25) 100%);
		pointer-events: none;
	}

	.hero-photo {
		display: block;
		width: 100%;
		height: auto;
		filter: saturate(0.78);
	}

	/* ── Sections ── */
	.section {
		padding: 4.5rem 0 0;
		border-top: 1px solid rgb(var(--border));
	}

	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 2rem;
	}

	.section-label {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		color: var(--accent);
	}

	.section-action {
		font-family: var(--font-mono);
		font-size: 0.6rem;
		letter-spacing: 0.1em;
		color: rgb(var(--text-muted));
		text-decoration: none;
		opacity: 0.5;
		transition: opacity 0.2s, color 0.2s;
	}
	.section-action:hover { opacity: 1; color: rgb(var(--text)); text-decoration: none; }

	/* ── Expertise ── */
.skill-group {
		display: flex; flex-direction: column; gap: 0.5rem;
		padding-right: 1.5rem;
	}
	.skill-group:last-child { padding-right: 0; }

	.sg-num {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		font-weight: 700;
		color: var(--accent);
		letter-spacing: 0.06em;
	}

	.sg-label {
		font-family: var(--font-mono);
		font-size: 0.58rem;
		letter-spacing: 0.1em;
		color: rgb(var(--text-muted));
		text-transform: uppercase;
	}

	.sg-items {
		list-style: none;
		padding: 0; margin: 0.25rem 0 0;
		display: flex; flex-direction: column; gap: 0.15rem;
	}

	.sg-items li {
		font-family: var(--font-display);
		font-size: 0.95rem;
		font-weight: 700;
		color: rgb(var(--text));
		line-height: 1.5;
	}

	/* ── Projects ── */
	.project-list { display: flex; flex-direction: column; }

	.fp-card {
		display: grid;
		grid-template-columns: 3fr 2fr;
		gap: 3rem;
		align-items: start;
		padding: 3rem 0;
		border-bottom: 1px solid rgb(var(--border));
	}
	.fp-card:first-child { padding-top: 0; }
	.fp-card:last-child { border-bottom: none; }

	.fp-sidebar {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		position: sticky;
		top: 6rem;
	}

	.fp-sidebar-header {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.fp-visual {
		border-radius: 8px;
		overflow: hidden;
		border: 1px solid rgb(var(--border));
		aspect-ratio: 16 / 8;
		position: relative;
	}
	.fp-visual::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(to bottom, transparent 40%, rgba(4, 7, 14, 0.55) 100%),
			linear-gradient(to right, rgba(4, 7, 14, 0.2) 0%, transparent 30%, transparent 70%, rgba(4, 7, 14, 0.2) 100%);
		pointer-events: none;
	}
	.fp-visual img { width: 100%; height: 100%; object-fit: cover; display: block; filter: saturate(0.82); }

	.fp-placeholder {
		width: 100%; height: 100%;
		background: linear-gradient(135deg, #060c18, #0b1628);
		display: flex; align-items: center; justify-content: center;
		position: relative; overflow: hidden;
	}
	.fp-placeholder::before {
		content: '';
		position: absolute; inset: 0;
		background-image:
			linear-gradient(rgba(91,140,255,0.05) 1px, transparent 1px),
			linear-gradient(90deg, rgba(91,140,255,0.05) 1px, transparent 1px);
		background-size: 32px 32px;
	}
	.fp-letter {
		font-family: var(--font-display);
		font-size: 7rem; font-weight: 900;
		color: rgba(91,140,255,0.06);
		position: relative; z-index: 1;
	}

	.fp-content { display: flex; flex-direction: column; gap: 1.25rem; }

	.fp-title {
		font-family: var(--font-display);
		font-size: 1.35rem; font-weight: 800;
		letter-spacing: -0.03em;
		color: rgba(255,255,255,0.88); margin: 0;
	}

	.fp-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; }
	.fp-tags span {
		padding: 0.15em 0.65em;
		background: rgba(91,140,255,0.07);
		border: 1px solid rgba(91,140,255,0.18);
		border-radius: 3px;
		font-family: var(--font-mono); font-size: 0.6rem;
		color: rgb(var(--text-muted)); letter-spacing: 0.04em;
	}

	.fp-meta {
		display: flex; flex-direction: column; gap: 0.2rem;
		font-family: var(--font-mono); font-size: 0.63rem;
		color: rgb(var(--text-muted)); letter-spacing: 0.04em;
	}
	.fp-type { color: var(--accent); opacity: 0.75; text-transform: uppercase; }

	.fp-desc {
		font-size: 0.82rem; line-height: 1.75;
		color: rgb(var(--text-muted)); margin: 0;
	}

	.fp-highlights { display: flex; flex-direction: column; gap: 0.6rem; }

	.fp-highlight-item {
		display: flex; flex-direction: column; gap: 0.25rem;
		padding: 0.75rem 0.9rem;
		border-left: 2px solid rgba(91,140,255,0.35);
		background: rgba(91,140,255,0.03);
	}

	.fph-title {
		font-family: var(--font-display);
		font-size: 0.82rem; font-weight: 700;
		color: var(--accent); letter-spacing: -0.01em;
	}

