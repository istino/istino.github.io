---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, GITHUB_URL } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="label">Game Client Developer</p>
				<h1>김민철</h1>
				<p class="desc">
					게임의 경험을 만드는 클라이언트 개발자.<br />
					C#과 Unity로 플레이어가 느끼는 순간을 설계합니다.
				</p>
				<div class="tech-stack">
					<span>C#</span>
					<span>Unity</span>
					<span>C++</span>
					<span>DirectX</span>
				</div>
				<div class="hero-links">
					<a href="/portfolio" class="btn-primary">포트폴리오 →</a>
					<a href="/resume" class="btn-secondary">이력서</a>
					<a href={GITHUB_URL} target="_blank" rel="noopener" class="btn-secondary">GitHub</a>
				</div>
			</section>

			{posts.length > 0 && (
				<section class="recent-posts">
					<h2>최근 글</h2>
					<ul>
						{posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<span class="post-title">{post.data.title}</span>
									<span class="post-date">{post.data.pubDate.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
								</a>
							</li>
						))}
					</ul>
					<a href="/blog" class="view-all">모든 글 보기 →</a>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 720px;
	}

	.hero {
		position: relative;
		padding: 5em 0 4em;
		border-bottom: 1px solid rgb(var(--border));
		overflow: hidden;
	}
	.hero::before {
		content: '';
		position: absolute;
		top: 40%;
		left: -15%;
		width: 600px;
		height: 500px;
		background: radial-gradient(ellipse, rgba(88, 166, 255, 0.1) 0%, transparent 65%);
		transform: translateY(-50%);
		pointer-events: none;
		z-index: 0;
	}
	.hero > * { position: relative; z-index: 1; }
	.label {
		font-size: 0.875rem;
		color: var(--accent);
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		margin: 0 0 0.75em;
	}
	.hero h1 {
		font-size: 3.5rem;
		font-weight: 800;
		letter-spacing: -0.03em;
		margin: 0 0 0.5em;
		line-height: 1;
		text-shadow: 0 0 60px rgba(88, 166, 255, 0.25);
	}
	.desc {
		font-size: 1.1rem;
		color: rgb(var(--text-muted));
		line-height: 1.6;
		margin: 0 0 1.5em;
	}
	.tech-stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		margin-bottom: 2em;
	}
	.tech-stack span {
		padding: 0.25em 0.75em;
		background: rgb(var(--bg-card));
		border: 1px solid rgb(var(--border));
		border-radius: 999px;
		font-size: 0.875rem;
		color: rgb(var(--text-muted));
		font-family: monospace;
	}
	.hero-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75em;
	}
	.btn-primary {
		padding: 0.6em 1.4em;
		background: var(--accent);
		color: rgb(var(--bg));
		border-radius: 6px;
		font-weight: 600;
		font-size: 0.95rem;
		text-decoration: none;
		transition: opacity 0.15s;
	}
	.btn-primary:hover {
		opacity: 0.85;
		text-decoration: none;
		color: rgb(var(--bg));
	}
	.btn-secondary {
		padding: 0.6em 1.4em;
		background: transparent;
		color: rgb(var(--text));
		border: 1px solid rgb(var(--border));
		border-radius: 6px;
		font-size: 0.95rem;
		text-decoration: none;
		transition: border-color 0.15s, background 0.15s;
	}
	.btn-secondary:hover {
		border-color: var(--accent);
		background: rgb(var(--bg-card));
		text-decoration: none;
		color: rgb(var(--text));
	}

	.recent-posts {
		padding: 3em 0;
	}
	.recent-posts h2 {
		font-size: 1.1rem;
		font-weight: 600;
		color: rgb(var(--text-muted));
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 1.25em;
	}
	ul {
		list-style: none;
		padding: 0;
		margin: 0 0 1.5em;
	}
	ul li a {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1em;
		padding: 0.75em 0;
		border-bottom: 1px solid rgb(var(--border));
		text-decoration: none;
		color: rgb(var(--text));
		transition: color 0.15s;
	}
	ul li a:hover {
		color: var(--accent);
		text-decoration: none;
	}
	.post-title {
		font-size: 1rem;
	}
	.post-date {
		font-size: 0.825rem;
		color: rgb(var(--text-muted));
		white-space: nowrap;
		flex-shrink: 0;
	}
	.view-all {
		font-size: 0.9rem;
		color: rgb(var(--text-muted));
	}
	.view-all:hover {
		color: var(--accent);
	}
</style>
